---
import BaseLayout from '../layouts/BaseLayout.astro';
import GitHubProjects from '../components/GitHubProjects.astro';
import { getRepos } from '../lib/github';
import { SITE } from '../consts';

const repos = await getRepos(12);
---

<BaseLayout title="项目" description={`${SITE.title} 的开源项目`}>
  <section class="container-wide py-16 sm:py-20">
    <header class="reveal mb-12 flex items-end justify-between gap-4">
      <div>
        <p class="font-mono text-xs uppercase tracking-[0.24em] text-accent">Open Source</p>
        <h1 class="mt-4 font-serif text-4xl">项目</h1>
        <p class="mt-3 text-muted">来自 GitHub @{SITE.github} 的公开仓库</p>
      </div>
      <a
        href={SITE.githubUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="hidden shrink-0 rounded-full border border-line px-5 py-2.5 text-sm transition-colors duration-300 hover:border-accent hover:text-accent sm:block"
      >
        查看 GitHub
      </a>
    </header>

    <div class="reveal reveal-delay-1">
      <GitHubProjects repos={repos} />
    </div>
  </section>
</BaseLayout>
