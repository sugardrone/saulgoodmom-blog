---
import { SITE } from '../consts';
const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-line">
  <div class="container-wide flex flex-col gap-4 py-10 text-sm text-muted sm:flex-row sm:items-center sm:justify-between">
    <p>
      © {year} {SITE.title} · {SITE.tagline}
    </p>
    <div class="flex items-center gap-5">
      <a class="link-underline hover:text-ink" href={SITE.githubUrl} target="_blank" rel="noopener noreferrer">GitHub</a>
      <a class="link-underline hover:text-ink" href="/rss.xml">RSS</a>
      <a class="link-underline hover:text-ink" href={`mailto:${SITE.email}`}>Email</a>
    </div>
  </div>
</footer>
