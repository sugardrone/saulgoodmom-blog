---
import { NAV, SITE } from '../consts';
import ThemeToggle from './ThemeToggle.astro';

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);
---

<header class="sticky top-0 z-50 border-b border-line/70 bg-canvas/80 backdrop-blur-md">
  <div class="container-wide flex h-16 items-center justify-between gap-4">
    <a href="/" class="group flex items-baseline gap-2">
      <span class="font-serif text-xl tracking-tight text-ink">{SITE.title}</span>
      <span class="hidden size-1.5 rounded-full bg-accent transition-transform duration-500 group-hover:scale-150 sm:block"></span>
    </a>

    <nav class="flex items-center gap-1 sm:gap-2">
      {
        NAV.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class:list={[
              'rounded-full px-3 py-1.5 text-sm transition-colors duration-300',
              isActive(item.href)
                ? 'text-accent'
                : 'text-muted hover:text-ink',
            ]}
          >
            {item.label}
          </a>
        ))
      }
      <span class="mx-1 h-4 w-px bg-line"></span>
      <ThemeToggle />
    </nav>
  </div>
</header>
