---
import type { Repo } from '../lib/github';

interface Props {
  repos: Repo[];
}

const { repos } = Astro.props;
const langColor: Record<string, string> = {
  TypeScript: '#3178c6',
  JavaScript: '#f1e05a',
  Python: '#3572A5',
  Go: '#00ADD8',
  Rust: '#dea584',
  Astro: '#ff5a03',
  HTML: '#e34c26',
  CSS: '#563d7c',
  Shell: '#89e051',
  Vue: '#41b883',
  Java: '#b07219',
  'C++': '#f34b7d',
};
---

{
  repos.length === 0 ? (
    <p class="text-sm text-muted">暂时无法获取 GitHub 项目（构建时未联网或触发限流）。</p>
  ) : (
    <div class="grid gap-4 sm:grid-cols-2">
      {repos.map((repo) => (
        <a
          href={repo.html_url}
          target="_blank"
          rel="noopener noreferrer"
          class="card group flex flex-col p-5"
        >
          <div class="flex items-center justify-between gap-3">
            <h3 class="truncate font-mono text-sm font-medium text-ink transition-colors duration-300 group-hover:text-accent">
              {repo.name}
            </h3>
            <span class="flex shrink-0 items-center gap-1 text-xs text-muted">
              <svg class="size-3.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="m12 2 2.9 6.3 6.9.6-5.2 4.5 1.5 6.7L12 16.9 5.9 20.1l1.5-6.7L2.2 8.9l6.9-.6L12 2z"></path>
              </svg>
              {repo.stargazers_count}
            </span>
          </div>

          <p class="mt-2 line-clamp-2 flex-1 text-sm leading-relaxed text-muted">
            {repo.description ?? '暂无描述'}
          </p>

          {repo.language && (
            <span class="mt-4 flex items-center gap-2 text-xs text-muted">
              <span
                class="size-2.5 rounded-full"
                style={`background-color:${langColor[repo.language] ?? 'var(--muted)'}`}
              />
              {repo.language}
            </span>
          )}
        </a>
      ))}
    </div>
  )
}
